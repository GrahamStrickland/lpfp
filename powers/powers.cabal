cabal-version:      3.0
name:               powers
version:            0.1.0.0
synopsis:           Prints the first 21 powers of 2
-- description:
homepage:           https://github.com/GrahamStrickland/lpfp.git
license:            BSD-3-Clause
license-file:       LICENSE
author:             Graham Strickland
maintainer:         grahamhstrickland@gmail.com
-- copyright:
category:           Math
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable powers
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.21.0.0
    hs-source-dirs:   app
    default-language: Haskell2010
